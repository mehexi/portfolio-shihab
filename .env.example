# Copy to .env.local and fill in. Until the project ID is set, the site
# renders the design's built-in copy and /studio shows setup instructions.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for the Sanity webhook that calls /api/revalidate on publish.
SANITY_REVALIDATE_SECRET=
